@{
    ViewData["Title"] = "About";
}

<style>

    /* Section spacing */

    .section-space {
        margin-top: 80px;
    }

    /* About image hover */

    .about-img {
        border-radius: 12px;
        transition: all 0.4s ease;
    }

        .about-img:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

    /* Feature cards */

    .choose-card {
        border: 1px solid #eee;
        padding: 40px 30px;
        transition: all 0.3s ease;
        cursor: pointer;
        height: 100%;
    }

        .choose-card:hover {
            background: #0d6efd;
            color: white;
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

        .choose-card b {
            font-size: 16px;
        }

    /* Footer hover */

    footer ul li {
        transition: all 0.3s ease;
        cursor: pointer;
    }

        footer ul li:hover {
            color: #0d6efd;
            transform: translateX(5px);
        }

</style>


<div class="container">


    <!-- ABOUT TITLE -->

    <div class="text-center section-space">

        <h2 class="text-secondary">

            ABOUT <span class="fw-bold text-dark">US</span>

        </h2>

    </div>


    <!-- ABOUT CONTENT -->

    <div class="row align-items-center section-space">

        <div class="col-md-4 text-center">

            <img src="https://prescripto.vercel.app/assets/about_image-MG9zrc7b.png"
                 class="img-fluid about-img">

        </div>


        <div class="col-md-6">

            <p class="text-muted">

                Welcome to MediBook, your trusted partner in managing your healthcare needs conveniently and efficiently.
                At MediBook, we understand the challenges individuals face when it comes to scheduling doctor appointments
                and managing their health records.

            </p>

            <p class="text-muted">

                MediBook is committed to excellence in healthcare technology. We continuously strive to enhance our
                platform, integrating the latest advancements to improve user experience and deliver superior service.

            </p>

            <b>Our Vision</b>

            <p class="text-muted">

                Our vision at MediBook is to create a seamless healthcare experience for every user. We aim to bridge
                the gap between patients and healthcare providers, making it easier for you to access the care you need,
                when you need it.

            </p>

        </div>

    </div>


    <!-- WHY CHOOSE US -->

    <div class="section-space">

        <h4>

            WHY <span class="fw-bold">CHOOSE US</span>

        </h4>

    </div>


    <div class="row g-4 section-space">

        <div class="col-md-4">

            <div class="choose-card">

                <b>EFFICIENCY</b>

                <p class="mt-3">

                    Streamlined appointment scheduling that fits into your busy lifestyle.

                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="choose-card">

                <b>CONVENIENCE</b>

                <p class="mt-3">

                    Access to a network of trusted healthcare professionals in your area.

                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="choose-card">

                <b>PERSONALIZATION</b>

                <p class="mt-3">

                    Tailored recommendations and reminders to help you stay on top of your health.

                </p>

            </div>

        </div>

    </div>


</div>