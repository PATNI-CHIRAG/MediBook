@{
    ViewData["Title"] = "Admin Login";
}

<style>

    .auth-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        border-radius: 12px;
        transition: 0.3s;
    }

        .auth-card:hover {
            transform: translateY(-4px);
        }

    .auth-input {
        border-radius: 8px;
    }

    .auth-btn {
        border-radius: 8px;
        transition: 0.3s;
    }

        .auth-btn:hover {
            transform: scale(1.02);
        }

</style>


<div class="container auth-container">

    <div class="card shadow-lg p-4 auth-card">

        <h3 class="fw-bold">Admin Login</h3>
        <p class="text-muted">Login to manage doctors</p>

        <form asp-controller="Admin" asp-action="Login" method="post">

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input name="email" type="email" class="form-control auth-input" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input name="password" type="password" class="form-control auth-input" required>
            </div>

            <button class="btn btn-primary w-100 auth-btn">
                Login
            </button>

            <p class="mt-3 text-center">
                Doctor Login? <a href="/DoctorAccount/Login">Click here</a>
            </p>

        </form>

    </div>

</div>