<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> MediBook </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalAppointmentSystem.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .nav-link:hover {
            color: #0d6efd !important;
        }

        .create-btn {
            transition: all 0.3s ease;
            font-weight: 500;
        }

            .create-btn:hover {
                background-color: #0d6efd;
                color: white;
                transform: scale(1.05);
            }

        .book-btn {
            transition: all 0.3s ease;
            font-weight: 500;
        }

            .book-btn:hover {
                background-color: #0d6efd;
                color: white;
                transform: scale(1.05);
            }

        /* Section spacing */

        .section-space {
            margin-top: 80px;
            margin-bottom: 40px;
        }

        /* Navbar hover */

        .nav-link {
            transition: all 0.3s ease;
        }

            .nav-link:hover {
                color: #0d6efd !important;
                transform: translateY(-2px);
            }

        footer {
            padding-top: 50px;
            padding-bottom: 20px;
        }

        .dropdown img:hover {
            transform: scale(1.1);
            transition: 0.2s;
        }

            /* Footer hover effects */

            footer ul li {
                transition: all 0.3s ease;
                cursor: pointer;
            }

                footer ul li:hover {
                    color: #0d6efd;
                    transform: translateX(5px);
                }

            /* Footer headings */

            footer h6, footer h5 {
                transition: all 0.3s ease;
            }

                footer h6:hover, footer h5:hover {
                    color: #0d6efd;
                }

            /* Contact text hover */

            footer p {
                transition: all 0.3s ease;
            }

            footer p:hover {
                color: #0d6efd;
            }

        .dropdown img {
            transition: 0.2s;
        }

            .dropdown img:hover {
                transform: scale(1.15);
            }

        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">

            <div class="container">

                <!-- Logo Left -->
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <img src="~/images/medibook-logo1.png"
                         alt="MediBook Logo"
                         height="50">
                </a>

                <!-- Hamburger Button -->
                <button class="navbar-toggler border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navbar Content -->
                <div class="collapse navbar-collapse" id="navbarContent">

                    <!-- Center Menu -->
                    <ul class="navbar-nav mx-auto gap-lg-3 text-center">

                        <li class="nav-item">
                            <a class="nav-link fw-semibold" href="/">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Doctors" asp-action="Index">Doctors</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Home" asp-action="About">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>

                    </ul>

                    <div class="d-flex flex-column flex-lg-row gap-2">

                        @{
                            var doctorId = Context.Session.GetInt32("DoctorID");
                            var admin = Context.Session.GetString("Admin");
                        }

                        @if (!User.Identity.IsAuthenticated && doctorId == null && admin == null)
                        {
                            <!-- No one logged in -->

                            <a asp-controller="DoctorAccount"
                               asp-action="Login"
                               class="btn btn-outline-primary rounded-pill px-4">
                                Admin / Doctor Panel
                            </a>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn btn-primary rounded-pill px-4">
                                Create Account
                            </a>
                        }

                        else if (admin != null)
                        {
                            <!-- Admin Logged In -->

                            <div class="dropdown">

                                <button class="btn p-0 border-0 bg-transparent dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">

                                    <img src="https://img.icons8.com/?size=100&id=sUU7wwvo6G2l&format=png&color=000000"
                                         class="rounded-circle"
                                         width="35">

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="Dashboard">
                                            Admin Dashboard
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Admin"
                                           asp-action="Logout">
                                            Logout
                                        </a>
                                    </li>

                                </ul>

                            </div>
                        }

                        else if (doctorId != null)
                        {
                            <!-- Doctor Logged In -->

                            <div class="dropdown">

                                <button class="btn p-0 border-0 bg-transparent dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">

                                    <img src="https://static.vecteezy.com/system/resources/previews/000/421/716/original/vector-doctor-icon.jpg"
                                         class="rounded-circle"
                                         width="35">

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Doctors"
                                           asp-action="Dashboard">
                                            Doctor Dashboard
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="DoctorAccount"
                                           asp-action="Logout">
                                            Logout
                                        </a>
                                    </li>

                                </ul>

                            </div>
                        }

                        else
                        {
                            <!-- Patient Logged In -->

                            <div class="dropdown">

                                <button class="btn p-0 border-0 bg-transparent dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">

                                    <img src="https://cdn-icons-png.flaticon.com/512/17446/17446833.png"
                                         class="rounded-circle"
                                         width="35">

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Doctors"
                                           asp-action="MyAppointments">
                                            My Appointments
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Account"
                                           asp-action="Logout">
                                            Logout
                                        </a>
                                    </li>

                                </ul>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </nav>
    </header>
    <div class="container">
        <main class="container flex-fill pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-auto pt-4 border-top px-lg-5">

        <div class="row">

            <div class="col-md-6">

                <h5 class="fw-bold">MediBook</h5>

                <p class="text-muted">
                    Lorem Ipsum is simply dummy text of the printing and typesetting industry.
                    Lorem Ipsum has been the industry's standard dummy text ever since the 1500s,
                    when an unknown printer took a galley of type and scrambled it to make a 
                    type specimen book.
                </p>

            </div>

            <div class="col-md-3">

                <h6 class="fw-bold">Company</h6>

                <ul class="list-unstyled text-muted">

                    <li>Home</li>
                    <li>About</li>
                    <li>Privacy Policy</li>

                </ul>

            </div>

            <div class="col-md-3">

                <h6 class="fw-bold">Get In Touch</h6>

                <p class="text-muted">
                    +123-456-7890 <br>
                    hospital@gmail.com
                </p>

            </div>

        </div>

        <hr />


        <p class="text-center pt-4 text-muted">
            MediBook - All Rights Reserved
        </p>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        var success = '@TempData["Success"]';
        var error = '@TempData["Error"]';

        if (success) {
            Swal.fire({
                icon: 'success',
                title: success,
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500
            });
        }

        if (error) {
            Swal.fire({
                icon: 'error',
                title: error,
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2500
            });
        }

    });
</script>

